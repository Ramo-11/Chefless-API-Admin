{
  "name": "chefless-api",
  "version": "1.0.0",
  "description": "Chefless REST API \u2014 Node.js + Express + TypeScript",
  "main": "src/index.ts",
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && cp -r src/views dist/views && cp -r src/public dist/public",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/seed-labels.ts",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "seed:images": "tsx src/scripts/seed/generate-images.ts",
    "seed:revalidate": "tsx src/scripts/seed/revalidate-images.ts",
    "seed:gallery": "tsx src/scripts/seed/build-gallery.ts",
    "seed:recipes": "tsx src/scripts/seed/seed-real-recipes.ts",
    "seed:chefless": "tsx src/scripts/seed/seed-chefless-recipes.ts",
    "seed:diets": "tsx src/scripts/seed/seed-diet-recipes.ts",
    "seed:clean-steps": "tsx src/scripts/seed/clean-chefless-steps.ts",
    "seed:remove-haram": "tsx src/scripts/seed/remove-haram-recipes.ts",
    "seed:dedupe-images": "tsx src/scripts/seed/dedupe-recipe-images.ts",
    "backfill:original-recipes": "tsx src/scripts/backfill-original-recipes-count.ts",
    "backfill:recipe-counters": "tsx src/scripts/backfill-recipe-counters.ts",
    "backfill:remix-signatures": "tsx src/scripts/backfill-remix-signatures.ts",
    "backfill:transactions": "tsx src/scripts/backfill-transactions.ts",
    "backfill:normalized-ingredients": "tsx src/scripts/backfill-normalized-ingredients.ts",
    "backfill:seed-dietary-tags": "tsx src/scripts/backfill-seed-dietary-tags.ts",
    "create-apple-review-user": "tsx src/scripts/create-apple-review-user.ts",
    "delete-apple-review-user": "tsx src/scripts/delete-apple-review-user.ts",
    "create-google-review-user": "tsx src/scripts/create-google-review-user.ts",
    "delete-google-review-user": "tsx src/scripts/delete-google-review-user.ts",
    "create-google-review-premium-user": "tsx src/scripts/create-google-review-premium-user.ts",
    "delete-google-review-premium-user": "tsx src/scripts/delete-google-review-premium-user.ts",
    "backfill-premium-grants": "tsx src/scripts/backfill-premium-grants.ts",
    "migrate:email-contact-index": "tsx src/scripts/drop-email-contact-unique-index.ts",
    "migrate:sync-indexes": "tsx src/scripts/sync-indexes.ts",
    "verify:indexes": "tsx src/scripts/verify-indexes.ts",
    "migrate:create-search-indexes": "tsx src/scripts/create-search-indexes.ts",
    "migrate:recompute-trending-scores": "tsx src/scripts/recompute-trending-scores.ts",
    "migrate:drop-redundant-indexes": "tsx src/scripts/drop-redundant-indexes.ts",
    "migrate:prod:sync-indexes": "DOTENV_CONFIG_PATH=.env.production tsx src/scripts/sync-indexes.ts",
    "verify:prod:indexes": "DOTENV_CONFIG_PATH=.env.production tsx src/scripts/verify-indexes.ts",
    "backfill:prod:normalized-ingredients": "DOTENV_CONFIG_PATH=.env.production tsx src/scripts/backfill-normalized-ingredients.ts",
    "backfill:prod:seed-dietary-tags": "DOTENV_CONFIG_PATH=.env.production tsx src/scripts/backfill-seed-dietary-tags.ts",
    "migrate:prod:create-search-indexes": "DOTENV_CONFIG_PATH=.env.production tsx src/scripts/create-search-indexes.ts",
    "migrate:prod:backfill-unlocked-cuisines": "DOTENV_CONFIG_PATH=.env.production tsx src/scripts/backfill-unlocked-cuisines.ts",
    "migrate:prod:backfill-passport-badges": "DOTENV_CONFIG_PATH=.env.production tsx src/scripts/backfill-passport-badges.ts",
    "migrate:prod:recompute-trending-scores": "DOTENV_CONFIG_PATH=.env.production tsx src/scripts/recompute-trending-scores.ts",
    "migrate:prod:drop-redundant-indexes": "DOTENV_CONFIG_PATH=.env.production tsx src/scripts/drop-redundant-indexes.ts",
    "migrate:backfill-unlocked-cuisines": "tsx src/scripts/backfill-unlocked-cuisines.ts",
    "migrate:backfill-passport-badges": "tsx src/scripts/backfill-passport-badges.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-ejs-layouts": "^2.5.4",
    "@types/express-session": "^1.18.2",
    "@types/node": "^22.13.5",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.8.1",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "ejs": "^5.0.1",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.19.0",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.1.0",
    "mongoose": "^8.10.1",
    "pino": "^10.3.1",
    "pino-pretty": "^11.2.2",
    "resend": "^4.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.0",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2",
    "vitest": "^4.0.18"
  }
}
